# ==================================================================
# VICEVERSE ENVIRONMENT CONFIGURATION (.env.local)
# ==================================================================

# Option A: Provide Project ID (e.g. "abcdefghijklmnop")
# NEXT_PUBLIC_SUPABASE_PROJECT_ID=your_project_id

# Option B: Provide Full Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase Anon / Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Data source override ('supabase' or 'mock')
# If omitted, Supabase is automatically used whenever URL & Anon Key are set!
NEXT_PUBLIC_DATA_SOURCE=supabase
